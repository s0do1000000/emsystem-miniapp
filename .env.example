# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
WEBAPP_URL=https://your-project.vercel.app
ADMIN_CHAT_ID=123456789

# Видео в самом боте (chat) — file_id, полученные один раз при загрузке
# видео в Telegram. Необязательные: если не заданы, бот просто не будет
# слать видео перед кнопкой Mini App.
VIDEO_ABOUT_FILE_ID=
VIDEO_LESSON_FILE_ID=

# Видео внутри Mini App (страницы /course и /free-lesson) — публичные
# ссылки, например из Supabase Storage (bucket course-videos, Public).
NEXT_PUBLIC_ABOUT_VIDEO_URL=
NEXT_PUBLIC_FREE_LESSON_VIDEO_URL=
